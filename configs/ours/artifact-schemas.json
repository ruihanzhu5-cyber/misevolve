{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:misevolve:ours:v1",
  "$defs": {
    "PolicyVersion": {
      "type": "object",
      "required": ["gen", "val", "rep", "parent", "evidence", "hash"],
      "properties": {
        "gen": {"type": "string", "minLength": 1},
        "val": {"type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"enum": ["behavior_retest", "cross_receiver", "successor"]}},
        "rep": {"type": "string", "minLength": 1},
        "parent": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rationale": {"type": "string"},
        "applicability": {"type": "string"},
        "expected_change": {"type": "string"}
      },
      "additionalProperties": false,
      "description": "Immutable content version. Lifecycle decision and active status are recorded by linked policy_change events and the atomic state pointer."
    },
    "SkillChange": {
      "type": "object",
      "required": ["operation", "skill_id", "parents", "name", "description", "instructions", "applicability", "dependencies", "reason"],
      "properties": {
        "operation": {"enum": ["create", "edit", "merge", "deactivate", "delete"]},
        "skill_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$"},
        "parents": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "name": {"type": "string"}, "description": {"type": "string"}, "instructions": {"type": "string"},
        "applicability": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "SplitManifest": {
      "type": "object", "required": ["schema_version", "tasks"], "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/SplitEntry"}}
      }
    },
    "SplitEntry": {
      "type": "object", "required": ["purpose", "sequence", "shard", "source_sha256", "task", "episode"],
      "additionalProperties": false,
      "properties": {
        "purpose": {"enum": ["online", "development", "inner_confirmation", "policy_selection", "outer_confirmation", "final_learning", "final_evaluation"]},
        "sequence": {"type": "string", "minLength": 1}, "shard": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "task": {"type": "object", "required": ["instance_id", "prompt", "kind", "round", "pos"],
                 "properties": {"instance_id": {"type": "string"}, "prompt": {"type": "string"},
                                "kind": {"enum": ["M", "B", "P"]}, "round": {"type": "integer"}, "pos": {"type": "integer"}}},
        "episode": {"type": "object", "required": ["malicious_goal"], "properties": {"malicious_goal": {"type": "string"}}}
      }
    },
    "EvaluationRecord": {
      "type": "object",
      "required": ["task_id", "kind", "sequence", "purpose", "pair_id", "library_hash", "policy_hash", "library_frozen", "policy_frozen", "risk", "utility", "status", "missing_reason", "environment_hash", "source_sha256", "topology", "action", "evidence", "token_cost"],
      "properties": {"risk": {"type": ["boolean", "null"]}, "utility": {"type": ["boolean", "null"]},
                     "library_frozen": {"const": true}, "policy_frozen": {"const": true},
                     "missing_reason": {"type": ["string", "null"]}, "token_cost": {"type": ["number", "null"]}}
    },
    "Decision": {
      "type": "object", "required": ["status", "reason", "metrics"], "additionalProperties": false,
      "properties": {"status": {"enum": ["ACCEPT", "REJECT", "HOLD"]}, "reason": {"type": "string"}, "metrics": {"type": "object"}}
    },
    "ImprovementEvent": {
      "type": "object", "required": ["index", "type"],
      "properties": {"index": {"type": "integer", "minimum": 0}, "type": {"type": "string"},
                     "decision": {"$ref": "#/$defs/Decision"}, "window": {"type": "integer", "minimum": 1}}
    },
    "Snapshot": {
      "type": "object",
      "required": ["window", "policy", "library", "events", "objects", "spent", "fingerprint", "integrity", "policies", "previous_policy", "rollback_streak"],
      "properties": {"integrity": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                     "window": {"type": "integer", "minimum": 0}, "events": {"type": "array"}, "spent": {"type": "array", "uniqueItems": true}}
    },
    "RunManifestExtension": {
      "type": "object", "required": ["mode", "base_sha", "source_hash"],
      "properties": {"mode": {"enum": ["fixed_theta", "adaptive_theta", "no_learning"]},
                     "base_sha": {"const": "4cc377300be179d71d72888347dc3e5ff1132a2d"},
                     "source_hash": {"type": "string"}, "seed": {"type": "integer"}, "checkpoint_windows": {"type": "array", "items": {"type": "integer"}}}
    }
  }
}
